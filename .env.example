# 키즈스키 환경변수 예시 — 실제 값은 .env.local 에 넣으세요(커밋 금지)

# ── 백엔드 (Phase 1) ────────────────────────────────
# 아래 두 값을 설정하면 앱이 자동으로 localStorage 대신 Supabase를 사용합니다.
# Supabase 대시보드 → Project Settings → API 에서 확인.
# 스키마는 src/lib/backend/schema.sql 을 SQL Editor에 붙여 실행하세요.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── 결제 (Phase 2) ──────────────────────────────────
# 토스페이먼츠 클라이언트 키. 없으면 모의 결제로 동작합니다.
# 실제 결제 승인(confirm)은 서버(시크릿 키)가 필요합니다.
VITE_TOSS_CLIENT_KEY=
